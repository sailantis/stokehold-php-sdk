{
    "name": "sailantis/stokehold-worker",
    "description": "The PHP worker SDK for stokehold: serves requests over the stokehold worker protocol.",
    "type": "library",
    "license": "MIT",
    "keywords": ["stokehold", "worker", "php-fpm", "application-server", "roadrunner"],
    "require": {
        "php": ">=8.2",
        "ext-hash": "*",
        "ext-json": "*"
    },
    "support": {
        "issues": "https://github.com/sailantis/stokehold-php-sdk/issues",
        "source": "https://github.com/sailantis/stokehold-php-sdk"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Stokehold\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stokehold\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    }
}
